<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_payment_method_tree_inherit_card_fee" model="ir.ui.view">
        <field name="name">payment.method.tree.inherit.card.fee</field>
        <field name="model">payment.method</field>
        <field name="inherit_id" ref="payment.payment_method_tree" />
        <field name="arch" type="xml">
            <field name="active" position="before">
                <field name="credit_card_admin" />
            </field>
        </field>
    </record>

    <record id="view_payment_method_form_inherit_card_fee" model="ir.ui.view">
        <field name="name">payment.method.form.inherit.card.fee</field>
        <field name="model">payment.method</field>
        <field name="inherit_id" ref="payment.payment_method_form" />
        <field name="arch" type="xml">
            <field name="active" position="before">
                <field name="credit_card_admin" />
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="Fee Ranges" name="fee_ranges" invisible="not credit_card_admin">
                    <field name="fee_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="installments_from" />
                            <field name="installments_to" />
                            <field name="fee_percent" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="sale_payment_method.menu_sale_payment_method" model="ir.ui.menu">
        <field name="active" eval="False" />
    </record>

</odoo>