<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_sale_payment_method_form_inherit_card_fee" model="ir.ui.view">
        <field name="name">sale.payment.method.form.inherit.card.fee</field>
        <field name="model">sale.payment.method</field>
        <field name="inherit_id" ref="sale_payment_method.view_sale_payment_method_form" />
        <field name="arch" type="xml">
            <field name="active" position="before">
                <field name="credit_card_admin" />
            </field>
            <xpath expr="//sheet/group" position="after">
                <notebook invisible="not credit_card_admin">
                    <page string="Fee Ranges" name="fee_ranges">
                        <field name="fee_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="installments_from" />
                                <field name="installments_to" />
                                <field name="fee_percent" />
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

</odoo>