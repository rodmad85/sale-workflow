<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form_inherit_card_fee" model="ir.ui.view">
        <field name="name">account.move.form.inherit.card.fee</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="tax_totals" position="before">
                <div
                    class="oe_subtotal_footer_separator pb-2"
                    invisible="not credit_card_fee_amount"
                >
                    <div class="d-flex justify-content-between">
                        <label
                            for="credit_card_fee_percent"
                            string="Fee (%)"
                            class="m-0"
                        />
                        <field
                            name="credit_card_fee_percent"
                            nolabel="1"
                            readonly="1"
                        />
                    </div>
                    <div class="d-flex justify-content-between">
                        <label
                            for="credit_card_fee_amount"
                            string="Fee Amount"
                            class="m-0"
                        />
                        <field name="credit_card_fee_amount" nolabel="1" readonly="1" />
                    </div>
                    <div class="d-flex justify-content-between">
                        <label
                            for="credit_card_amount_plus_fee"
                            string="Amount + Fee"
                            class="m-0"
                        />
                        <field
                            name="credit_card_amount_plus_fee"
                            nolabel="1"
                            readonly="1"
                        />
                    </div>
                </div>
            </field>
            <field name="invoice_payment_term_id" position="after">
                <field
                    name="payment_method_ids"
                    widget="many2many_tags"
                    placeholder="Payment Methods"
                    invisible="not payment_method_ids"
                />
            </field>
        </field>
    </record>
</odoo>
