<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form_inherit_card_fee" model="ir.ui.view">
        <field name="name">account.move.form.inherit.card.fee</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- The payment methods of the invoice are added by
                 sale_payment_method, next to the due date. -->
            <xpath expr="//notebook" position="inside">
                <page
                    string="Credit Card Fees"
                    name="credit_card_fees"
                    invisible="not credit_card_fee_line_ids"
                >
                    <field name="credit_card_fee_line_ids" nolabel="1" readonly="1">
                        <list create="false" delete="false">
                            <field
                                name="payment_method_id"
                                string="Credit Card Administrator"
                            />
                            <field name="sum_fee" string="Add Fee" />
                            <field
                                name="fee_range_id"
                                string="Credit Card Fee Range"
                            />
                            <field name="fee_percent" string="Fee (%)" />
                            <field name="amount" string="Amount" />
                            <field name="fee_amount" string="Fee Amount" />
                        </list>
                    </field>
                </page>
            </xpath>
            <field name="tax_totals" position="after">
                <div
                    class="oe_subtotal_footer_separator pt-2"
                    invisible="not credit_card_fee_amount"
                >
                    <div class="d-flex justify-content-between">
                        <label
                            for="credit_card_fee_percent"
                            string="Fee (%)"
                            class="m-0"
                        />
                        <field
                            name="credit_card_fee_percent"
                            nolabel="1"
                            readonly="1"
                        />
                    </div>
                    <div class="d-flex justify-content-between">
                        <label
                            for="credit_card_fee_amount"
                            string="Fee Amount"
                            class="m-0"
                        />
                        <field name="credit_card_fee_amount" nolabel="1" readonly="1" />
                    </div>
                    <div class="d-flex justify-content-between">
                        <label
                            for="credit_card_amount_plus_fee"
                            string="Amount + Fee"
                            class="m-0"
                        />
                        <field
                            name="credit_card_amount_plus_fee"
                            nolabel="1"
                            readonly="1"
                        />
                    </div>
                </div>
            </field>
        </field>
    </record>
</odoo>
