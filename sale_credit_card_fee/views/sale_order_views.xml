<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_inherit_card_fee" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.card.fee</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="payment_method_ids" position="before">
                <div invisible="not credit_card_fee_line_ids" class="mt-2">
                    <group string="Credit Card Fees">
                        <field name="credit_card_fee_line_ids" colspan="2" nolabel="1">
                            <list editable="bottom" create="false" delete="false">
                                <field
                                    name="payment_method_id"
                                    string="Credit Card Administrator"
                                    readonly="1"
                                    force_save="1"
                                />
                                <field name="sum_fee" string="Add Fee" />
                                <field
                                    name="fee_range_id"
                                    string="Credit Card Fee Range"
                                />
                                <field name="fee_percent" string="Fee (%)" />
                            </list>
                        </field>
                    </group>
                </div>
            </field>
            <xpath
                expr="//group[@name='sale_total']/field[@name='tax_totals']"
                position="before"
            >
                <div
                    class="d-flex justify-content-between"
                    invisible="not credit_card_fee_amount"
                >
                    <label for="credit_card_fee_percent" string="Fee (%)" class="m-0" />
                    <field name="credit_card_fee_percent" nolabel="1" readonly="1" />
                </div>
                <div
                    class="d-flex justify-content-between"
                    invisible="not credit_card_fee_amount"
                >
                    <label
                        for="credit_card_fee_amount"
                        string="Fee Amount"
                        class="m-0"
                    />
                    <field name="credit_card_fee_amount" nolabel="1" readonly="1" />
                </div>
                <div
                    class="d-flex justify-content-between"
                    invisible="not credit_card_fee_amount"
                >
                    <label
                        for="credit_card_amount_plus_fee"
                        string="Amount + Fee"
                        class="m-0"
                    />
                    <field
                        name="credit_card_amount_plus_fee"
                        nolabel="1"
                        readonly="1"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
